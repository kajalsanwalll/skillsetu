generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  clerkId        String          @unique
  name           String
  email          String          @unique
  role           UserRole?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  opportunities  Opportunity[]   @relation("IndustryOpportunities")
  studentProfile StudentProfile?
}

model StudentProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  careerInterest        String?
  bio                   String?

  resumeUrl             String?
  resumePublicId        String?
  resumeFileName        String?
  resumeUploadedAt      DateTime?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  academicCredentials   AcademicCredential[]
  applications          Application[]
  assessments           Assessment[]
  evidence              SkillEvidence[]
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                StudentSkill[]
}

model Skill {
  id                String             @id @default(cuid())
  name              String             @unique
  category          String?
  description       String?

  opportunitySkills OpportunitySkill[]
  evidence          SkillEvidence[]
  studentSkills     StudentSkill[]
}

model StudentSkill {
  id                   String               @id @default(cuid())
  studentProfileId     String
  skillId              String
  proficiency          Float               @default(0)
  competencyLevel      CompetencyLevel?
  verificationStrength VerificationStrength @default(UNVERIFIED)

  skill                Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  studentProfile       StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId])
}

model SkillEvidence {
  id                   String               @id @default(cuid())
  studentProfileId     String
  skillId              String

  type                 EvidenceType
  title                String
  description          String?
  url                  String?
  score                Float?

  verified             Boolean              @default(false)
  verificationStrength VerificationStrength  @default(UNVERIFIED)

  createdAt            DateTime             @default(now())

  skill                Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  studentProfile       StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model AcademicCredential {
  id                   String               @id @default(cuid())
  studentProfileId     String

  source               String
  credentialId         String?
  title                String
  institution          String?
  score                Float?
  credits              Float?
  issueDate            DateTime?
  verificationUrl      String?

  verified             Boolean              @default(false)
  verificationStrength VerificationStrength @default(UNVERIFIED)

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  studentProfile       StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Assessment {
  id               String         @id @default(cuid())
  studentProfileId String

  title            String
  score            Float

  createdAt        DateTime       @default(now())

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id           String             @id @default(cuid())
  title        String
  company      String
  description  String
  location     String?
  type         OpportunityType

  industryId   String
  createdAt    DateTime           @default(now())

  applications Application[]

  industry     User               @relation("IndustryOpportunities",fields: [industryId],references: [id])

  skills       OpportunitySkill[]
}

model OpportunitySkill {
  id                  String          @id @default(cuid())
  opportunityId       String
  skillId             String
  required            Boolean         @default(true)
  weight              Float           @default(1)
  minimumProficiency   Float           @default(0)
  requiredLevel        CompetencyLevel @default(FOUNDATIONAL)

  opportunity         Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill               Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, skillId])
}

model Application {
  id               String         @id @default(cuid())
  studentProfileId String
  opportunityId    String

  matchScore       Float?
  status           String         @default("APPLIED")

  createdAt        DateTime       @default(now())

  opportunity      Opportunity    @relation(fields: [opportunityId],references: [id],onDelete: Cascade)

  studentProfile   StudentProfile @relation(fields: [studentProfileId],references: [id],onDelete: Cascade)

  @@unique([studentProfileId, opportunityId])
}

enum UserRole {
  STUDENT
  INDUSTRY
  FACULTY
  ADMIN
}

enum CompetencyLevel {
  EXPOSURE
  FOUNDATIONAL
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EvidenceType {
  ASSESSMENT
  PROJECT
  CERTIFICATION
  INTERNSHIP
  SELF_REPORTED
  NPTEL
  ACADEMIC_CREDENTIAL
}

enum VerificationStrength {
  HIGH
  MEDIUM
  LOW
  UNVERIFIED
}

enum OpportunityType {
  INTERNSHIP
  JOB
  PROJECT
  MENTORSHIP
  FDP
  RESEARCH
  CONSULTANCY
  INDUSTRIAL_TRAINING
  GUEST_LECTURE
}